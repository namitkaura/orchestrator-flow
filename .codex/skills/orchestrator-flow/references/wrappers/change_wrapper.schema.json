{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orchestrator-flow:change-wrapper",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "anyOf": [
        {
          "$ref": "urn:orchestrator-flow:common#/$defs/invocation"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "string"
    },
    "output_kind": {
      "enum": [
        "incremental",
        "consolidated"
      ]
    },
    "artifacts": {
      "$ref": "urn:orchestrator-flow:common#/$defs/artifacts"
    },
    "artifact_changes": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/artifact_change"
      },
      "minItems": 0
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "minItems": 0
    },
    "new_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "minItems": 0
    },
    "deleted_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "minItems": 0
    },
    "cli_runs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "test_results": {
      "$ref": "urn:orchestrator-flow:common#/$defs/test_results"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/check"
      },
      "minItems": 0
    },
    "implementation_details": {
      "type": "string",
      "minLength": 1
    },
    "task_progress": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/task_progress"
      },
      "minItems": 0
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/blocker"
      },
      "minItems": 0
    },
    "dispositions": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/disposition"
      },
      "minItems": 0
    },
    "causes": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/reference"
      },
      "minItems": 0
    },
    "cumulative_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/evidence"
      },
      "minItems": 0
    }
  },
  "required": [
    "context",
    "notes",
    "output_kind",
    "artifacts",
    "artifact_changes",
    "changed_files",
    "new_files",
    "deleted_files",
    "cli_runs",
    "test_results",
    "checks",
    "implementation_details",
    "task_progress",
    "blockers",
    "dispositions",
    "causes",
    "cumulative_scope",
    "evidence"
  ]
}

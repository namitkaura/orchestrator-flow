{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orchestrator-flow:spec-review-wrapper",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "anyOf": [
        {
          "$ref": "urn:orchestrator-flow:common#/$defs/invocation"
        },
        {
          "type": "null"
        }
      ]
    },
    "accepted": {
      "enum": [
        "true",
        "false",
        "conditional"
      ]
    },
    "issue_details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must_fix": {
          "type": "array",
          "items": {
            "$ref": "urn:orchestrator-flow:common#/$defs/finding"
          },
          "minItems": 0
        },
        "should_fix": {
          "type": "array",
          "items": {
            "$ref": "urn:orchestrator-flow:common#/$defs/finding"
          },
          "minItems": 0
        },
        "nit": {
          "type": "array",
          "items": {
            "$ref": "urn:orchestrator-flow:common#/$defs/finding"
          },
          "minItems": 0
        }
      },
      "required": []
    },
    "dispositions": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/disposition"
      },
      "minItems": 0
    },
    "reviewed_artifacts": {
      "$ref": "urn:orchestrator-flow:common#/$defs/artifacts"
    },
    "reviewed_output_ref": {
      "anyOf": [
        {
          "$ref": "urn:orchestrator-flow:common#/$defs/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_kind": {
      "enum": [
        "initial",
        "follow_up"
      ]
    },
    "assurance_level": {
      "$ref": "urn:orchestrator-flow:common#/$defs/assurance"
    },
    "repair_class": {
      "anyOf": [
        {
          "enum": [
            "editorial",
            "test_documentation",
            "bounded_correctness",
            "architectural_systemic"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "changed_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "minItems": 0
    },
    "review_scope": {
      "enum": [
        "focused",
        "affected",
        "full"
      ]
    },
    "scope_reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/evidence"
      },
      "minItems": 1
    },
    "resolved_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "meaningful_change": {
      "type": "boolean"
    },
    "reviewed_commit": {
      "anyOf": [
        {
          "$ref": "urn:orchestrator-flow:common#/$defs/commit"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/check"
      },
      "minItems": 0
    }
  },
  "required": [
    "context",
    "summary",
    "reviewed_output_ref",
    "assurance_level",
    "review_scope",
    "accepted",
    "issue_details"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "context": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "reviewed_artifacts",
          "reviewed_commit",
          "review_kind"
        ],
        "properties": {
          "reviewed_output_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "reviewed_output_ref": {
            "$ref": "urn:orchestrator-flow:common#/$defs/reference"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "reviewed_artifacts"
              ]
            },
            {
              "required": [
                "reviewed_commit"
              ]
            },
            {
              "required": [
                "review_kind"
              ]
            }
          ]
        }
      }
    }
  ]
}

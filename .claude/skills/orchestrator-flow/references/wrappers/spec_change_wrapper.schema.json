{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orchestrator-flow:spec-change-wrapper",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "anyOf": [
        {
          "$ref": "urn:orchestrator-flow:common#/$defs/invocation"
        },
        {
          "type": "null"
        }
      ]
    },
    "output_kind": {
      "enum": [
        "incremental",
        "consolidated"
      ]
    },
    "artifacts": {
      "$ref": "urn:orchestrator-flow:common#/$defs/artifacts"
    },
    "artifact_changes": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/artifact_change"
      },
      "minItems": 0
    },
    "causes": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/reference"
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "downstream_impacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "dispositions": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/disposition"
      },
      "minItems": 0
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "research_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "urn:orchestrator-flow:common#/$defs/evidence"
            },
            "minItems": 1
          }
        },
        "required": [
          "ref",
          "summary",
          "rationale",
          "evidence"
        ]
      },
      "minItems": 0
    },
    "checkpoint_commit": {
      "anyOf": [
        {
          "$ref": "urn:orchestrator-flow:common#/$defs/commit"
        },
        {
          "type": "null"
        }
      ]
    },
    "implementation_phases": {
      "type": "array",
      "items": {
        "$ref": "urn:orchestrator-flow:common#/$defs/implementation_phase"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "context",
    "output_kind",
    "summary",
    "artifacts",
    "checkpoint_commit"
  ]
}
